# {{ ansible_managed }}
#
# One file rather than edits to the packaged defaults: the distribution owns
# jail.conf and rewrites it on upgrade, so anything put there is temporary.

[DEFAULT]
banaction = {{ fail2ban_banaction }}
banaction_allports = {{ fail2ban_banaction }}[type=allports]
# The journal backend, for the jails that read the journal. A jail that names a
# file must say so itself: fail2ban drops `logpath` without a word the moment
# the backend starts with "systemd" (jailreader.py), and the jail then watches
# the whole journal with a pattern that never occurs there
backend = {{ fail2ban_backend }}

# Never ban the tunnel: an administrator locked out of the panel has to reach
# the node another way, and the tunnel is that way. The ranges are the same
# declaration the metrics pull is pinned to, so the two cannot drift apart
ignoreip = {{ fail2ban_ignoreip | join(' ') }}

[sshd]
enabled = true
maxretry = {{ fail2ban_sshd_maxretry }}
findtime = {{ fail2ban_sshd_findtime }}
bantime = {{ fail2ban_sshd_bantime }}

{% if fail2ban_recidive_enabled %}
# Reads fail2ban's own log, so it sees whoever came back after being banned
[recidive]
enabled = true
# fail2ban writes its bans to the file below, not to the journal, so the jail
# reading them cannot inherit the journal backend
backend = auto
logpath = /var/log/fail2ban.log
findtime = {{ fail2ban_recidive_findtime }}
bantime = {{ fail2ban_recidive_bantime }}
maxretry = {{ fail2ban_recidive_maxretry }}
{% endif %}

{% if fail2ban_ipl_enabled %}
# The panel decides what counts as too many addresses for one client; this jail
# only acts on what the panel already wrote down
[3x-ipl]
enabled = true
# The panel writes a file; the jail has to read a file. This is the line the
# panel's own jail carries, and dropping it silently unbans everyone
backend = auto
filter = 3x-ipl
action = 3x-ipl[name=3x-ipl, bantime={{ fail2ban_ipl_bantime }}]
logpath = {{ fail2ban_ipl_logpath }}
maxretry = 1
findtime = {{ fail2ban_ipl_findtime }}
bantime = {{ fail2ban_ipl_bantime }}
{% endif %}
