# {{ ansible_managed }}
#
# The panel's address-limit ban, written with nftables like every other ban
# on the node, so one `nft list ruleset` shows all of them. Built on
# fail2ban's own nftables action: the shared f2b-table, a set per jail, the
# address-family handling — only what differs is stated here.
#
# Bans every protocol for the address. Nothing is spared by default:
# administration arrives over the tunnel, which the jail's ignoreip excludes
# from banning entirely, and the panel listens on the tunnel address only -
# so an exception would weaken the ban without buying a way back in.
[INCLUDES]
before = nftables.conf

[Definition]
{% if fail2ban_ipl_exempt_ports %}
# Every transport port except the exempt ones; th is the transport header,
# so this reads tcp and udp alike
rule_match-allports = th dport != \{ {{ fail2ban_ipl_exempt_ports | replace(',', ', ') }} \}
{% else %}
# No layer-4 match at all: the source address is the whole rule
rule_match-allports =
{% endif %}

# The panel's own log of who was banned and when, which its menu reads
actionban = <nftables> add element <table_family> <table> <addr_set> \{ <ip> \}
            echo "$(date -Is) BAN <ip>" >> <banned_log>

actionunban = <nftables> delete element <table_family> <table> <addr_set> \{ <ip> \}
              echo "$(date -Is) UNBAN <ip>" >> <banned_log>

[Init]
type = allports
name = 3x-ipl
banned_log = {{ fail2ban_ipl_logpath | dirname }}/3xipl-banned.log
# fail2ban defers actionstart to the first ban for any action with a
# per-family section, which the nftables action has. Started at jail start
# instead, so the set a ban lands in exists from the beginning and its
# absence means what the checker says it means
actionstart_on_demand = false
