# {{ ansible_managed }}
# Where the units that push send their numbers, read as an EnvironmentFile=.
# Derived from backup_url, the one place the station is named. No password:
# the push reads it from the backup role's file at the moment it needs it
SKIBIDI_PUSH_BASE={{ backup_url | regex_replace('^(https?://(?:\\[[^\\]]+\\]|[^/:]+)).*$', '\\1') }}:{{ metrics_push_port }}
SKIBIDI_PUSH_USER={{ backup_user }}
SKIBIDI_PUSH_PASSWORD_FILE={{ backup_config_dir }}/rest-password
# The backup script owns the rule that plain HTTP is allowed inside the tunnel
# alone, and the push asks it instead of keeping a copy of the rule
SKIBIDI_PUSH_GUARD="{{ backup_script }} target"
# The master's reporter writes its traffic here, and the push adds it
SKIBIDI_PUSH_TEXTFILE={{ metrics_push_textfile }}
# The push also tells the station each urgent problem the node reports of
# itself, which is the failures the last self-check recorded
SKIBIDI_CHECK_RESULT={{ checker_result_file }}
SKIBIDI_CHECK_MAX_AGE_HOURS={{ checker_result_max_age_hours }}
