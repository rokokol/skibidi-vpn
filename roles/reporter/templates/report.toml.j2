# {{ ansible_managed }}
# Read by /usr/local/sbin/skibidi-report. Holds no credential: the panel token
# is minted by the panel's own CLI at each run and never touches disk.

[report]
timezone = "{{ reporter_timezone }}"
hour = {{ reporter_hour }}
weekday = {{ reporter_weekday_index[reporter_weekday] }}
to = "{{ reporter_to }}"
sender = "skibidi-vpn@{{ inventory_hostname }}"
master_name = "{{ inventory_hostname }}"

[panel]
url = "{{ reporter_panel_url }}"
verify_tls = false

[paths]
state_dir = "{{ reporter_state_dir }}"
sendmail = "{{ reporter_sendmail }}"
ssh_user = "{{ metrics_export_user }}"

{% for host in groups['nodes'] | default([]) | sort if host != inventory_hostname %}
# metrics_host is the registry's own word for where the pull goes — a tailnet
# address, which the checker holds it to. It defaults to the panel's listen
# address only as a bridge for registries that have not declared it yet; the
# two are different decisions and must be separable
[[nodes]]
name = "{{ host }}"
host = "{{ hostvars[host].metrics_host | default(hostvars[host].xui_listen_ip) }}"
{% endfor %}
