# {{ ansible_managed }}
# The settings of skibidi-daily, read as an EnvironmentFile=. A run by hand
# takes them from here through systemd-run, so it sees what the unit sees
SKIBIDI_LIB={{ metrics_lib_dir }}
SKIBIDI_CHECK_RESULT={{ checker_result_file }}
SKIBIDI_CHECK_MAX_AGE_HOURS={{ checker_result_max_age_hours }}
SKIBIDI_API_URL=http://{{ '[' ~ metrics_host ~ ']' if ':' in metrics_host else metrics_host }}:{{ metrics_api_port }}
SKIBIDI_REPORT_BIN=/usr/local/sbin/skibidi-report
