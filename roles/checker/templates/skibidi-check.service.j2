# {{ ansible_managed }}
[Unit]
Description=Assert this node is in the state it was deployed into
# %N, not %n: %n already ends in .service, and appending another
# suffix names the instance skibidi-alert@skibidi-check.service.service
OnFailure=skibidi-alert@%N.service
# Without these, Restart= on a failing unit never reaches the failed state and
# OnFailure never fires
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/skibidi-check
