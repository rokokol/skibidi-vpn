#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Everything this node claims about itself, asserted against the running
# machine. Written to be read by whoever is woken up by its failure: each check
# prints what is wrong and why it matters, and the last line printed is what the
# alert mail puts in its subject.
#
# Exit 0 means every check passed. Any other exit means the node is not in the
# state it was deployed into, and the OnFailure unit sends the journal.

set -uo pipefail

failures=0

fail() {
    printf 'FAIL %s\n' "$*"
    failures=$((failures + 1))
}

ok() {
    printf 'ok   %s\n' "$*"
}

# --- services ---------------------------------------------------------------

for unit in {{ checker_required_units | join(' ') }}; do
    if systemctl is-active --quiet "$unit"; then
        ok "$unit is running"
    else
        fail "$unit is not running"
    fi
    if ! systemctl is-enabled --quiet "$unit" 2>/dev/null; then
        fail "$unit is not enabled and will not survive a reboot"
    fi
done

# --- kernel settings --------------------------------------------------------
#
# The file being correct is not the same as the kernel having taken it: a later
# drop-in wins silently, and the node then runs with settings nobody chose.

declared=$(grep -lE '^\s*net\.(core\.default_qdisc|ipv4\.tcp_congestion_control)' \
    /etc/sysctl.conf /etc/sysctl.d/*.conf 2>/dev/null | wc -l)
if [ "$declared" -eq 1 ]; then
    ok "congestion control is declared in exactly one file"
else
    fail "$declared files declare congestion control; the last one read wins"
fi

for pair in "net.ipv4.tcp_congestion_control={{ common_congestion_control }}" \
            "net.core.default_qdisc={{ common_qdisc }}" \
            "net.netfilter.nf_conntrack_max={{ common_conntrack_max }}"; do
    key=${pair%%=*}
    want=${pair#*=}
    have=$(sysctl -n "$key" 2>/dev/null)
    if [ "$have" = "$want" ]; then
        ok "$key is $have"
    else
        fail "$key is $have, expected $want"
    fi
done

# The queue discipline has to be on the interface that carries the traffic, not
# merely the default for new ones
iface=$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')
if [ -n "$iface" ]; then
    if tc qdisc show dev "$iface" 2>/dev/null | grep -q '{{ common_qdisc }}'; then
        ok "$iface uses {{ common_qdisc }}"
    else
        fail "$iface does not use {{ common_qdisc }}"
    fi
fi

# --- conntrack pressure -----------------------------------------------------
#
# The table filling up drops connections with nothing in any log to say so

max=$(sysctl -n net.netfilter.nf_conntrack_max 2>/dev/null || echo 0)
count=$(sysctl -n net.netfilter.nf_conntrack_count 2>/dev/null || echo 0)
if [ "$max" -gt 0 ]; then
    used=$((count * 100 / max))
    if [ "$used" -lt 80 ]; then
        ok "conntrack ${used}% used ($count of $max)"
    else
        fail "conntrack ${used}% used ($count of $max); new connections will be dropped"
    fi
fi

# --- firewall ---------------------------------------------------------------

if ufw status 2>/dev/null | grep -q '^Status: active'; then
    ok "ufw is active"
else
    fail "ufw is not active"
fi

# The outward-facing surface, compared against what this node declares. A rule
# nobody remembers adding is the shape of a mistake: the legend rests on a node
# looking like an ordinary web server, and one stray port undoes it. Rules bound
# to the tunnel interface are excluded - the tunnel is not the outside.
declared_tcp="{{ (firewall_tcp_open + (firewall_tcp_open_from | default([]) | map(attribute='port') | list)) | map('string') | join(' ') }}"
declared_udp="{{ firewall_udp_open | default([]) | map('string') | join(' ') }}"

open_now=$(ufw status 2>/dev/null \
    | awk '/ALLOW/ && !/on {{ firewall_tunnel_interface }}/ {print $1}' \
    | grep -oE '^[0-9]+(/(tcp|udp))?' | sort -u)

unexpected=""
for entry in $open_now; do
    port=${entry%%/*}
    proto=${entry#*/}
    [ "$proto" = "$entry" ] && proto=tcp
    case " $declared_tcp $declared_udp " in
        *" $port "*) ;;
        *) unexpected="$unexpected $entry" ;;
    esac
done

if [ -z "$unexpected" ]; then
    ok "the firewall opens only what this node declares"
else
    fail "the firewall also allows$unexpected, which this node does not declare"
fi

for port in $declared_tcp $declared_udp; do
    if printf '%s\n' "$open_now" | grep -qE "^${port}(/|$)"; then
        :
    else
        fail "port $port is declared open but the firewall does not allow it"
    fi
done

# A service answering on a public address that the firewall does not admit is
# usually deliberate - a spare inbound kept closed, say - but it is also exactly
# what a service bound wider than intended looks like, so it is said out loud
# rather than left to be noticed
noted=""
ephemeral_from=$(sysctl -n net.ipv4.ip_local_port_range 2>/dev/null | awk '{print $1}')
ephemeral_from=${ephemeral_from:-32768}
default_addr=$(ip -4 -o addr show dev "${iface:-eth0}" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
if [ -n "$default_addr" ]; then
    while read -r proto laddr; do
        [ -n "$laddr" ] || continue
        port=${laddr##*:}
        case "$laddr" in
            "$default_addr":*|'*:'*|'0.0.0.0:'*|'[::]:'*) ;;
            *) continue ;;
        esac
        case " $declared_tcp $declared_udp {{ firewall_tailscale_port | default(41641) }} " in
            *" $port "*) continue ;;
        esac
        # Ports the kernel hands out for outgoing connections. Xray opens one per
        # upstream connection, so they change constantly and mean nothing here -
        # listing them would drown the notes that matter
        if [ "$port" -ge "$ephemeral_from" ] 2>/dev/null; then
            continue
        fi
        # One line per port, not per address family
        case " $noted " in
            *" $proto/$port "*) continue ;;
        esac
        noted="$noted $proto/$port"
        ok "note: $proto/$port listens publicly but the firewall does not admit it"
    done <<EOF
$(ss -lntuH 2>/dev/null | awk '{print $1, $5}')
EOF
fi

{% if firewall_hide_tailscale_direct | default(true) %}
# The legend rests on this: the address answering Reality on 443 must not also
# emit WireGuard, or the two are trivially the same host
if iptables -S ufw-before-output 2>/dev/null | grep -q -- '--sport {{ firewall_tailscale_port }} -j DROP'; then
    ok "the tailscale direct path is dropped"
else
    fail "the tailscale drop rule is not loaded; this address emits WireGuard"
fi

# The port is written in two places and a drift makes the rule match nothing
# while looking exactly as before
daemon_port=$(. /etc/default/tailscaled 2>/dev/null; echo "${PORT:-}")
if [ -z "$daemon_port" ] || [ "$daemon_port" = "{{ firewall_tailscale_port }}" ]; then
    ok "tailscaled uses the port the rule drops"
else
    fail "tailscaled uses port $daemon_port but the rule drops {{ firewall_tailscale_port }}"
fi
{% endif %}

# --- fail2ban ---------------------------------------------------------------

for jail in {{ checker_required_jails | join(' ') }}; do
    if fail2ban-client status "$jail" >/dev/null 2>&1; then
        ok "fail2ban jail $jail answers"
    else
        fail "fail2ban jail $jail does not answer"
    fi
done

{% if fail2ban_ipl_enabled | default(true) %}
# A jail can be loaded, green, and reading the wrong thing: with a journal
# backend fail2ban drops the jail's logpath silently, and the panel's log is
# never opened. Which file the jail holds open is the only honest question
opened=$(fail2ban-client get 3x-ipl logpath 2>/dev/null)
case "$opened" in
    *"{{ fail2ban_ipl_logpath }}"*) ok "the 3x-ipl jail reads {{ fail2ban_ipl_logpath }}" ;;
    *) fail "the 3x-ipl jail does not read {{ fail2ban_ipl_logpath }}; it watches the journal and bans nobody" ;;
esac

# The set a ban is written into has to exist in the kernel, or the jail is
# reading its log for nothing
if nft list set inet f2b-table addr-set-3x-ipl >/dev/null 2>&1; then
    ok "the 3x-ipl ban set exists in nftables"
else
    fail "nftables has no addr-set-3x-ipl; the panel's bans have nowhere to land"
fi

# A filter that no longer matches its log is the quiet failure here: the jail
# loads, its status is green, and it bans nobody. The panel owns the log format
# and can change it in any release, so the filter is tested against the log
# rather than assumed to still fit it.
log={{ fail2ban_ipl_logpath }}
if [ -s "$log" ]; then
    matched=$(fail2ban-regex "$log" /etc/fail2ban/filter.d/3x-ipl.conf 2>/dev/null \
        | awk '/^Lines:/ {print}' | grep -oE '[0-9]+ matched' | grep -oE '^[0-9]+')
    if [ "${matched:-0}" -gt 0 ]; then
        ok "the 3x-ipl filter still matches the panel's log"
    else
        fail "the 3x-ipl filter matches nothing in $log; the panel changed its format and nobody is being banned"
    fi
else
    ok "the panel has logged no address-limit events"
fi
{% endif %}

# --- the panel --------------------------------------------------------------
#
# A panel on a public address exposes every client secret and every Reality
# private key, so where it listens is checked rather than assumed

listeners=$(ss -ltnH "sport = :{{ xui_panel_port }}" 2>/dev/null | awk '{print $4}')
if [ -z "$listeners" ]; then
    fail "nothing listens on the panel port {{ xui_panel_port }}"
else
    stray=$(printf '%s\n' "$listeners" | grep -v '{{ xui_listen_ip }}' || true)
    if [ -z "$stray" ]; then
        ok "the panel answers only on {{ xui_listen_ip }}"
    else
        fail "the panel also answers on $(echo "$stray" | tr '\n' ' ')"
    fi
fi

# The panel creates its database world-readable, and every copy this role's
# backup takes inherits that. The file holds every client credential and the
# Reality private keys, so its mode is the whole difference between "root can
# read it" and "the export account can read it"
if [ -d "$(dirname {{ xui_db }})" ]; then
    loose=$(find "$(dirname {{ xui_db }})" -maxdepth 1 \( -perm -o+r -o -perm -g+r \) \
        \( -type d -o -name "$(basename {{ xui_db }})*" \) 2>/dev/null | wc -l)
    if [ "$loose" -eq 0 ]; then
        ok "the panel database and its copies are readable by root alone"
    else
        fail "$loose file(s) under $(dirname {{ xui_db }}) are readable beyond root; every client secret is in them"
    fi
fi

# Every enabled inbound should have something listening for it. A port that
# stopped answering is a protocol nobody can connect to, and the panel goes on
# showing the inbound as enabled
if [ -r {{ xui_db }} ]; then
    while read -r port; do
        [ -n "$port" ] || continue
        if ss -lntuH "sport = :$port" 2>/dev/null | grep -q .; then
            ok "inbound port $port is served"
        else
            fail "inbound port $port is enabled but nothing listens on it"
        fi
    # Only this machine's own inbounds. A master's database also holds the
    # inbounds of every node it drives, and those are served there, not here -
    # checking them would report a healthy fleet as broken. node_id is 0 or
    # absent for a local one
    done < <(sqlite3 {{ xui_db }} "select distinct port from inbounds
             where enable = 1 and coalesce(node_id, 0) = 0" 2>/dev/null)
fi

# --- the timers that watch everything else ----------------------------------
#
# A watchdog that stopped cannot report that it stopped. systemd records when
# each timer last fired, so silence past its own interval is the signal.

{% for timer in checker_watched_timers %}
if systemctl list-unit-files '{{ timer.name }}' 2>/dev/null | grep -q '{{ timer.name }}'; then
    last=$(systemctl show -p LastTriggerUSec --value '{{ timer.name }}' 2>/dev/null)
    if [ -z "$last" ] || [ "$last" = "n/a" ]; then
        ok "{{ timer.name }} has not fired yet"
    else
        last_epoch=$(date -d "$last" +%s 2>/dev/null || echo 0)
        age_hours=$(( ($(date +%s) - last_epoch) / 3600 ))
        if [ "$last_epoch" -gt 0 ] && [ "$age_hours" -gt {{ timer.max_silence_hours }} ]; then
            fail "{{ timer.name }} last fired ${age_hours}h ago, over its {{ timer.max_silence_hours }}h limit"
        else
            ok "{{ timer.name }} fired ${age_hours}h ago"
        fi
    fi
fi
{% endfor %}

# --- the master -------------------------------------------------------------
#
# A master cannot report its own death, and an alert routed through it dies with
# it. So each node watches its own master and mails directly, past it.

{% if checker_master_url %}
state=/var/lib/skibidi-check/master-failures
mkdir -p "$(dirname "$state")"
if curl -sk --max-time 10 -o /dev/null "{{ checker_master_url }}"; then
    ok "the master answers"
    printf '0' > "$state"
else
    seen=$(cat "$state" 2>/dev/null || echo 0)
    seen=$((seen + 1))
    printf '%s' "$seen" > "$state"
    # A single miss is a network hiccup; a run of them is an outage. Counting
    # across runs rather than retrying within one keeps a slow master from
    # holding this script open
    if [ "$seen" -ge {{ checker_master_failures_before_alert }} ]; then
        fail "the master has not answered for $seen consecutive checks"
    else
        ok "the master missed a check ($seen of {{ checker_master_failures_before_alert }})"
    fi
fi
{% endif %}

# --- the mail path ----------------------------------------------------------
#
# The letters name every client and every node. Either they ride the tunnel,
# or they ride TLS; a cleartext session to a public address is the one shape
# that must never appear, and it is exactly what a registry edit can produce

{% if checker_smtp %}
if [ -r /etc/msmtprc ]; then
    intake_inside=$(python3 - <<'PYEOF'
import ipaddress
ranges = [ipaddress.ip_network(r) for r in "{{ metrics_tunnel_ranges | join(' ') }}".split()]
try:
    inside = any(ipaddress.ip_address("{{ checker_smtp | regex_replace(':[0-9]+$', '') }}") in r for r in ranges)
except ValueError:  # a hostname resolves wherever DNS says today
    inside = False
print("yes" if inside else "no")
PYEOF
)
    if grep -qE '^\s*tls\s+on' /etc/msmtprc; then
        ok "the mail path is encrypted"
    elif [ "$intake_inside" = "yes" ]; then
        ok "the mail path stays on the tunnel"
    else
        fail "the mail path is cleartext to {{ checker_smtp }}, which is outside the tunnel"
    fi
fi
{% endif %}

# --- the metrics pull -------------------------------------------------------
#
# The weekly pull must ride the tunnel by declaration, not by coincidence. The
# from= restriction on the nodes pins where the pull may come from; this end
# pins where it may go, because the moment a configured address is public, the
# fleet's metrics cross the open internet.

{% if 'master' in group_names %}
if [ -r /etc/skibidi/report.toml ]; then
    strays=$(python3 - <<'PYEOF'
import ipaddress
import tomllib

ranges = [ipaddress.ip_network(r) for r in "{{ metrics_tunnel_ranges | join(' ') }}".split()]
with open("/etc/skibidi/report.toml", "rb") as handle:
    nodes = tomllib.load(handle).get("nodes", [])
for node in nodes:
    try:
        inside = any(ipaddress.ip_address(node["host"]) in r for r in ranges)
    except ValueError:  # a hostname resolves wherever DNS says today
        inside = False
    if not inside:
        print(node["name"])
PYEOF
)
    if [ -z "$strays" ]; then
        ok "the metrics pull stays on the tunnel"
    else
        fail "the metrics pull would leave the tunnel for: $(printf '%s' "$strays" | tr '\n' ' ')"
    fi
fi

# No passphrase is possible on an unattended key, so its file mode is the whole
# protection and drifts silently when the file gets copied around
pull_key=/root/.ssh/skibidi-report
if [ -e "$pull_key" ]; then
    key_perms=$(stat -c '%a:%U' "$pull_key")
    if [ "$key_perms" = "600:root" ]; then
        ok "the pull key is readable by root alone"
    else
        fail "the pull key is $key_perms, expected 600:root, and it has no passphrase behind it"
    fi
fi
{% endif %}

# The export account's whole security is the leash on its key: from= pins the
# tunnel, restrict strips every ssh feature, command= forces the guard. The
# shell cannot be the fence — sshd runs the forced command through it, so it
# has to be real — which makes a key line missing any part of the leash, or an
# extra key somebody added "for a minute", the drift to catch
if export_home=$(getent passwd {{ metrics_export_user }} | cut -d: -f6); then
    export_keys="$export_home/.ssh/authorized_keys"
    if [ -r "$export_keys" ]; then
        # The exact string the role writes, built from the same variables — not
        # a pattern. A pattern that accepts "some from=" would wave through
        # from="0.0.0.0/0", which un-pins the tunnel while looking dressed
        leash='from="{{ metrics_tunnel_ranges | join(",") }}",restrict,command="/usr/local/sbin/skibidi-metrics ssh-guard" '
        loose=$(awk -v leash="$leash" 'NF && index($0, leash) != 1' "$export_keys" | wc -l)
        if [ "$loose" -eq 0 ]; then
            ok "every key on {{ metrics_export_user }} wears the exact leash"
        else
            fail "$loose key(s) on {{ metrics_export_user }} do not wear the leash the role writes"
        fi
    fi
fi

# --- WARP -------------------------------------------------------------------
#
# Only where the node declares it. A watchdog is a repair that hides the thing
# it repairs: a tunnel restarted six times a day looks healthy at every single
# moment, and only the count of restarts says otherwise. So the question is not
# whether WARP is up now, but how often it had to be revived to stay that way.

{% if 'warp' in group_names %}
if systemctl is-active --quiet warp-svc; then
    ok "warp-svc is running"
else
    fail "warp-svc is not running"
fi

verdict=$(WARP_WD_DRY_RUN=1 /usr/local/sbin/warp-watchdog 2>/dev/null)
case "$verdict" in
    *verdict=healthy*) ok "WARP carries traffic ($verdict)" ;;
    *) fail "WARP is up but not carrying traffic: $verdict" ;;
esac

restart_log={{ warp_state_dir | default('/var/lib/warp-watchdog') }}/restarts
if [ -r "$restart_log" ]; then
    day_ago=$(( $(date +%s) - 86400 ))
    recent=$(awk -v since="$day_ago" '$1 >= since' "$restart_log" 2>/dev/null | wc -l)
    if [ "$recent" -lt {{ warp_restarts_before_alert | default(3) }} ]; then
        ok "WARP restarted ${recent} time(s) in the last day"
    else
        fail "WARP was restarted ${recent} times in a day; the watchdog is holding up something that keeps failing"
    fi
fi
{% endif %}

# --- certificates -----------------------------------------------------------

{% if certs_domain | default('') %}
cert={{ certs_install_dir }}/{{ certs_fullchain_name }}
if [ -r "$cert" ]; then
    if openssl x509 -checkend $(( {{ certs_min_days_left }} * 86400 )) -noout -in "$cert" >/dev/null 2>&1; then
        ok "the certificate has more than {{ certs_min_days_left }} days left"
    else
        fail "the certificate expires within {{ certs_min_days_left }} days"
    fi
else
    fail "no certificate at $cert, which is where the panel reads it"
fi
{% endif %}

# --- xray -------------------------------------------------------------------

if [ -x /usr/local/x-ui/bin/xray-linux-amd64 ] && [ -r /usr/local/x-ui/bin/config.json ]; then
    if /usr/local/x-ui/bin/xray-linux-amd64 run -test -config /usr/local/x-ui/bin/config.json >/dev/null 2>&1; then
        ok "xray accepts its generated configuration"
    else
        fail "xray rejects its generated configuration; it is running on the last good one"
    fi
fi

# The summary goes last on purpose: the alert mail takes the final line as its
# subject, so it has to say how bad things are rather than what was checked last
if [ "$failures" -eq 0 ]; then
    printf 'all checks passed on %s\n' "$(hostname)"
    exit 0
fi
printf '%s check(s) failed on %s\n' "$failures" "$(hostname)"
exit 1
