---
extends: default

rules:
  # ansible-lint refuses a configuration that disagrees with its own yaml rule:
  # a comment glued to its code and an octal written without its prefix are what
  # that rule is for, so they are enforced here too
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  # Comments here explain the failure a task prevents; wrapping them at 80
  # columns costs more readability than it buys
  line-length: disable
  # `{ src: ..., dest: ... }` with padding is the style ansible-lint itself
  # permits; forbidding the spaces would only churn readable lines
  braces:
    max-spaces-inside: 1
  # GitHub named a workflow's trigger key `on`; that is their schema, not a
  # boolean that lost its way
  truthy:
    check-keys: false
