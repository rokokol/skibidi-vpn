# The private node registry never lives here. inventory.example/ is the template
inventory/nodes/
# The role secrets, passed with -e; vault.example.yml is the template
/vault.yml

# Secret-bearing artefacts. These are deliberately narrow: a blanket *secret*
# once swallowed tests/no-secrets.sh, so the guard against leaks was itself
# untracked and the flake check was the only thing that noticed
*.vault
*.db
*.db-*
*.pem
*.key
*.p12
secrets/
**/*.token
**/*credentials*

*.retry
# direnv's cache of the evaluated shell; the shell itself is the flake's
.direnv/
*.bak
__pycache__/
.venv/
result
result-*

# Rendered letter showcases, rebuilt at will by tests/make-samples.py
samples/
